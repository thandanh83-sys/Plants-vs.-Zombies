; ============================================================
; VĂN ĐẠO: BÚT TRẬN — Project Configuration
; Engine: Godot 4.2+
; ============================================================
; File này cấu hình toàn bộ dự án Godot:
;   - Tên game, phiên bản, icon
;   - Scene khởi động (Main.tscn)
;   - Các Autoload (singleton scripts toàn cục)
;   - Kích thước cửa sổ (1280x720)
;   - Renderer: GL Compatibility (hỗ trợ Web tốt)
; ============================================================

config_version=5

; ------------------------------------------------------------
; [application] — Thông tin cơ bản của game
; ------------------------------------------------------------
[application]

config/name="Văn Đạo: Bút Trận"
config/description="Game Tower Defense 2D lấy cảm hứng từ Plants vs. Zombies, khoác lên mình triết lý Văn Đạo."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
boot_splash/bg_color=Color(0.968627, 0.988235, 0.976471, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="VandaoButTran"

; ------------------------------------------------------------
; [autoload] — Các script chạy xuyên suốt game (singleton)
; ------------------------------------------------------------
; Dấu "*" phía trước nghĩa là Godot sẽ tự động tạo instance
; của script này khi game khởi động.
; ------------------------------------------------------------
[autoload]

GameData="*res://scripts/autoload/GameData.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"

; ------------------------------------------------------------
; [display] — Cấu hình cửa sổ hiển thị
; ------------------------------------------------------------
[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

; ------------------------------------------------------------
; [rendering] — Cấu hình đồ họa
; ------------------------------------------------------------
; GL Compatibility: dùng OpenGL thay vì Vulkan
; → Tương thích tốt hơn với Web và máy yếu
; ------------------------------------------------------------
[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.968627, 0.988235, 0.976471, 1)

; ------------------------------------------------------------
; [input] — Định nghĩa các phím tắt (sẽ dùng sau)
; ------------------------------------------------------------
[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
